# --- Database -----------------------------------------------------------------
POSTGRES_USER=pickem
POSTGRES_PASSWORD=pickem
POSTGRES_DB=pickem
DATABASE_URL=postgres://pickem:pickem@localhost:5432/pickem

# --- NATS ---------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# --- Telegram bot -------------------------------------------------------------
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional public webhook endpoint (leave empty to use long polling)
TELEGRAM_WEBHOOK_URL=

# --- Football data API --------------------------------------------------------
# https://www.football-data.org/
FOOTBALL_API_KEY=

# --- HTTP API service ---------------------------------------------------------
API_BIND_ADDR=0.0.0.0:8080
# Origin allowed by CORS (the Mini App's public URL). Defaults to the Vite
# dev server when unset.
MINIAPP_ORIGIN=http://localhost:5173
# Mini App URL fed to Telegram's `web_app` inline buttons and the DM menu
# button. Defaults to the Vite dev server; pin a distinct HTTPS value in
# production.
MINIAPP_URL=http://localhost:5173

# --- Events scorer ------------------------------------------------------------
# Cadence of the scorer's reconcile loop, in seconds. The loop catches
# matches finished while the scorer was down, group standings pending
# transition, and best-thirds waiting for the R16 bracket. Default: 600.
# SCORER_RECONCILE_INTERVAL_SECS=600

# --- OpenTelemetry / Jaeger ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAMESPACE=fut-worlds-pickem

# --- Logging ------------------------------------------------------------------
# Per-target overrides take the binary names: bot, api, events.
RUST_LOG=info,bot=debug,api=debug,events=debug
